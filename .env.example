# Where the official minted renders are served from, without a trailing slash.
# The wallet picker loads <base>/<slug>/<mint>.png; leave it unset and it
# composites the same look from trait layers instead, which is pixel-identical.
# Populate the bucket with `pnpm renders:upload` — see README.
NEXT_PUBLIC_RENDER_BASE_URL=

# The Solana RPC the browser calls to list a connected wallet's token accounts.
# Optional — lib/rpc-endpoint.ts ships a working default. Being NEXT_PUBLIC_ it
# is readable by anyone who views source, which is inherent to calling an RPC
# from the browser: rate-limit and domain-restrict it at the provider. Holders
# can override it with their own endpoint from the wallet modal.
# Piggy Gang resolves its Metaplex Core holdings through the DAS API, so the
# endpoint must also support `searchAssets` (the shipped default does); one
# without DAS degrades only Piggy Gang's wallet features.
NEXT_PUBLIC_SOLANA_RPC_URL=
